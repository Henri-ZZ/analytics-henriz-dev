HENRIZ_AUTH_BASE_URL=https://auth.henriz.dev
HENRIZ_AUTH_CLIENT_ID=henri-analytics-dev
HENRIZ_AUTH_CLIENT_SECRET=
HENRIZ_AUTH_REDIRECT_URI=https://localhost:3000/auth/callback

# 至少 32 字符；用于签发本站的 HttpOnly 会话 JWT
AUTH_JWT_SECRET=

# 本地开发可临时跳过认证；生产环境永远不会读取该值
HENRIZ_AUTH_BYPASS=false

# ---- Edit Page 遥测数据源 ----
# Edit Page 的 Neon Postgres 连接串，只读查询用（服务端使用，不会暴露到浏览器）
# 建议在 Neon 上单独建一个只读角色，只授予 public schema 下三张表的 SELECT
EDIT_PAGE_DATABASE_URL=postgresql://readonly:password@host/database?sslmode=require
